# Copie pra .env e preencha com as credenciais do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > SDK setup).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true pra conectar nos emuladores locais (firebase emulators:start)
VITE_USE_EMULATORS=false

# Cloudflare Worker que dispara Resend/Twilio (worker/) — URL que o
# `wrangler deploy` imprime no final.
VITE_WORKER_URL=
